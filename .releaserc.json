{
  "branches": ["main"],
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "releaseRules": [{ "type": "security", "release": "patch" }]
      }
    ],
    [
      "@semantic-release/exec",
      {
        "verifyReleaseCmd": "node .github/scripts/changelog-release.mjs check ${nextRelease.version}",
        "generateNotesCmd": "node .github/scripts/changelog-release.mjs notes ${nextRelease.version}"
      }
    ]
  ]
}
